# Copy this file to .env and fill in real values. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
PIN_HASH_PEPPER=change-me-to-a-different-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=pet_digital
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# OpenAI API key used to verify PPE photos in the field wizard (see
# permits.ppe_verification). Required — without it the PPE step can't be
# completed and permits requiring PPE verification can't be issued.
OPENAI_API_KEY=
OPENAI_PPE_VERIFICATION_MODEL=gpt-4o-mini
