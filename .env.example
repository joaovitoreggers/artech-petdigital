# Copy this file to .env and fill in real values. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
PIN_HASH_PEPPER=change-me-to-a-different-long-random-string
# Fernet key (32 url-safe base64 bytes) backing every reversible-encrypted
# field in the app (a worker's PIN shown to a manager, webhook secrets...).
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-to-a-generated-fernet-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=pet_digital
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# OpenAI API key used to verify PPE photos in the field wizard (see
# permits.ppe_verification). Required — without it the PPE step can't be
# completed and permits requiring PPE verification can't be issued.
OPENAI_API_KEY=
OPENAI_PPE_VERIFICATION_MODEL=gpt-4o-mini
OPENAI_DOCUMENT_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini
